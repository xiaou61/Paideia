{
  "name": "paideia-frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "dev": "pnpm --filter @paideia/app dev",
    "dev:admin": "pnpm --filter @paideia/admin dev",
    "dev:ui-kit": "pnpm --filter @paideia/ui-kit dev",
    "build": "pnpm --filter @paideia/app build",
    "build:desktop": "pnpm --filter @paideia/desktop build",
    "preview": "pnpm --filter @paideia/app preview",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @paideia/app test:e2e",
    "test:e2e:admin": "pnpm --filter @paideia/admin test:e2e",
    "test:e2e:ui-kit": "pnpm --filter @paideia/ui-kit test:e2e",
    "test:e2e:all": "pnpm -r --parallel --filter \"!@paideia/desktop\" test:e2e"
  },
  "devDependencies": {
    "jsdom": "^30.1.3",
    "mermaid": "^12.2.0",
    "subset-font": "^2.9.0",
    "typescript": "7.0.2"
  }
}

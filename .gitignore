# ---- 本地敏感配置：绝不提交 ----
# 本仓库是公开仓库。凭据一旦提交即视为已泄露，删除文件无法补救（历史与 fork 仍可检索）。
.env
.env.*
!.env.example
# 桌面端构建变量：只含后端地址，不含任何凭据，需要提交
!frontend/apps/app/.env.desktop
*.local
*.local.*
!.env.example
.secrets/
secrets/
*.pem
*.key
*.p12
*.jks
*.keystore
application-local.properties
application-local.yml
application-local.yaml
application-secret.properties
application-secret.yml
application-secret.yaml

# ---- 后端构建产物 ----
target/
build/
out/
!.mvn/wrapper/maven-wrapper.jar
# Python 脚本被 import 时生成的字节码（scripts/ 下有几个校验脚本）
__pycache__/
*.pyc

# ---- 前端与桌面壳构建产物 ----
node_modules/
dist/
dist-ssr/
.vite/
.turbo/
.cache/
src-tauri/target/
src-tauri/gen/
# 桌面端：renderer 是 SPA 产物的拷贝，release 是安装包输出
frontend/apps/desktop/renderer/
frontend/apps/desktop/release/

# ---- 运行期数据 ----
*.log
logs/
*.pid
*.hprof

# ---- 测试产物 ----
test-results/
playwright-report/
blob-report/
# ego 点击测试的失败截图（WORK-059）；报告入台账，截图不入库。
.agent/testing/.artifacts/
# ego runner 的当次参数（cli.mjs 生成，含模块名与模式，不含凭据）。
scripts/ego/.run.json
# playwright-cli 的页面快照（skill 的临时产物，不是本项目的内容）。
# 不加这行它会一直以未跟踪状态留在工作区，把 project-lifecycle 的
# "工作区是否干净"判定弄脏 —— 于是验证报告会被判 stale（实测过一次）。
.playwright-cli/
coverage/
# 设计原型截图与本地排查脚本（figcraft / playwright-cli 的产物，不是本项目内容）。
# 与上面 .playwright-cli/ 同一理由：留着会把工作区判定弄脏，验证报告被判 drift。
docs/design/
output/

# ---- IDE 与操作系统 ----
.idea/
.vscode/
!.vscode/extensions.json
*.iml
*.ipr
*.iws
.DS_Store
Thumbs.db
desktop.ini

# ---- 代码索引（CodeGraph 生成，可重建，约 5MB） ----
# 不进仓库：它是按本机生成的索引，`codegraph index --force` 可重建。
# 没有这条规则时，一次 `git add -A` 就会把它提交进公开仓库。
.codegraph/

# ---- 并发会话的独立工作区（git worktree） ----
# 多个会话同时改这个仓库时各开一个树，互不踩 target/ 与工作区状态。
.worktrees/

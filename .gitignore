# ---- 本地敏感配置：绝不提交 ----
# 本仓库是公开仓库。凭据一旦提交即视为已泄露，删除文件无法补救（历史与 fork 仍可检索）。
.env
.env.*
!.env.example
# 桌面端构建变量：只含后端地址，不含任何凭据，需要提交
!frontend/apps/app/.env.desktop
*.local
*.local.*
!.env.example
.secrets/
secrets/
*.pem
*.key
*.p12
*.jks
*.keystore
application-local.properties
application-local.yml
application-local.yaml
application-secret.properties
application-secret.yml
application-secret.yaml

# ---- 后端构建产物 ----
target/
build/
out/
!.mvn/wrapper/maven-wrapper.jar
# Python 脚本被 import 时生成的字节码（scripts/ 下有几个校验脚本）
__pycache__/
*.pyc

# ---- 前端与桌面壳构建产物 ----
node_modules/
dist/
dist-ssr/
.vite/
.turbo/
.cache/
**/src-tauri/target/
**/src-tauri/gen/
# 桌面端：renderer 是 SPA 产物的拷贝；安装包与中间产物都在 src-tauri/target 下（上面已忽略）
frontend/apps/desktop/renderer/

# ---- 运行期数据 ----
*.log
logs/
*.pid
*.hprof
# Redis 本地快照（跑本机 e2e 时 redis 落盘的 dump.rdb，不是本项目内容）
*.rdb

# ---- 测试产物 ----
test-results/
playwright-report/
blob-report/
# 本地手工跑 e2e 时攒下的日志、探针脚本与截图（不是台账产物）
.tmp-e2e/
# 全接口自查（ApiWalkthroughTest）每次本地跑都会写一份：单份 220+ 行端点表、
# 约 150KB，内容全部由测试自动生成、可随时重跑。按 .agent/testing/README.md
# 的规矩 contract / smoke 的运行记录要入台账，但 walkthrough 的量级完全是重跑噪声，
# 只忽略这一种，别把整个 runs/ 关掉。
.agent/testing/runs/*-walkthrough-local.md
# 会话里的临时日志、探针脚本与截图（.shots/ 是我和 agent 排查时的草稿区）
/.shots/
# 个人在用的工作清单，属于本机状态，不是项目内容
.agent/ai-flavor-worklist.json
# ego 点击测试的失败截图（WORK-059）；报告入台账，截图不入库。
.agent/testing/.artifacts/
# ego runner 的当次参数（cli.mjs 生成，含模块名与模式，不含凭据）。
scripts/ego/.run.json
# playwright-cli 的页面快照（skill 的临时产物，不是本项目的内容）。
# 不加这行它会一直以未跟踪状态留在工作区，把 project-lifecycle 的
# "工作区是否干净"判定弄脏 —— 于是验证报告会被判 stale（实测过一次）。
.playwright-cli/
coverage/
# 设计原型截图与本地排查脚本（figcraft / playwright-cli 的产物，不是本项目内容）。
# 与上面 .playwright-cli/ 同一理由：留着会把工作区判定弄脏，验证报告被判 drift。
docs/design/
output/

# ---- 本地原型草稿与一次性构建收据 ----
# .agent/prototypes 下是设计原型草稿、本地排查脚本与截图（figcraft / archify 的产物），
# 不是需要入库的项目内容；留着会让 project-lifecycle 的"工作区是否干净"判定变脏。
# work076 的报告截图此前已入库，gitignore 不影响已跟踪文件。
.agent/prototypes/
# Archify 全景图 finalize 的四道闸收据：含本机绝对路径、可重新生成，权威源是 .archify.json。
docs/architecture/paideia-architecture.browser-check.json
docs/architecture/paideia-architecture.delivery.json
docs/architecture/paideia-architecture.finalize.json
docs/architecture/paideia-architecture.finalize-summary.json

# ---- IDE 与操作系统 ----
.idea/
.vscode/
!.vscode/extensions.json
*.iml
*.ipr
*.iws
.DS_Store
Thumbs.db
desktop.ini

# ---- 代码索引（CodeGraph 生成，可重建，约 5MB） ----
# 不进仓库：它是按本机生成的索引，`codegraph index --force` 可重建。
# 没有这条规则时，一次 `git add -A` 就会把它提交进公开仓库。
.codegraph/

# ---- 并发会话的独立工作区（git worktree） ----
# 多个会话同时改这个仓库时各开一个树，互不踩 target/ 与工作区状态。
.worktrees/

# ---- 仓库根上的误产物 ----
# 根目录没有前端 workspace（前端在 frontend/），下面三个是在根目录误跑
# `npm init` / `pnpm install` 以及手工丢进来的压缩包留下的，不是本项目内容。
# 2026-11-02 发现它们以未跟踪状态挂在根上：一次 `git add -A` 就会提交进公开仓库。
# 一律锚定根路径——不锚定的话 `/pnpm-lock.yaml` 会去匹配 frontend/pnpm-lock.yaml 这类真正该入库的文件。
/package.json
/pnpm-lock.yaml
/.agent/html.rar

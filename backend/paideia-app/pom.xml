<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.xiaou61</groupId>
    <artifactId>paideia</artifactId>
    <version>0.0.1-SNAPSHOT</version>
  </parent>

  <artifactId>paideia-app</artifactId>
  <name>paideia-app</name>
  <description>Spring Boot 启动模块：主类、配置装配、模块边界校验</description>

  <dependencies>
    <dependency>
      <groupId>io.github.xiaou61</groupId>
      <artifactId>paideia-platform</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.xiaou61</groupId>
      <artifactId>paideia-web</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.xiaou61</groupId>
      <artifactId>paideia-persistence</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.xiaou61</groupId>
      <artifactId>paideia-security</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.xiaou61</groupId>
      <artifactId>paideia-account</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.xiaou61</groupId>
      <artifactId>paideia-knowledge</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.xiaou61</groupId>
      <artifactId>paideia-note</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.xiaou61</groupId>
      <artifactId>paideia-ai</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.xiaou61</groupId>
      <artifactId>paideia-sandbox</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.xiaou61</groupId>
      <artifactId>paideia-mcp</artifactId>
    </dependency>

    <!--
      schema 迁移。数据源只在 local/test profile 提供，默认 profile 下不存在数据源，Flyway 自然不执行。

      注意 spring-boot-flyway 这一项**不能省**：Boot 4 把各自动装配拆成了独立模块
      （spring-boot-jackson、spring-boot-webmvc 同理），只引 flyway-core 的话
      FlywayAutoConfiguration 根本不在类路径上——表现为"迁移从不执行"，
      既不报错也不打日志，表和约束静默不存在。这一条是实测出来的。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-mysql</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- 运维监控（WORK-028）：把 Micrometer 指标按 Prometheus 文本格式输出。
         版本由 Boot BOM 管，不写。 -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <!-- WORK-043 P2：一条 starter 带 Micrometer Tracing + OTLP；不用 Java agent。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-opentelemetry</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Boot 4 把测试切片拆到独立模块：@WebMvcTest / @AutoConfigureMockMvc 都在这里 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- 复用持久层的测试夹具（示例表迁移与示例 mapper），不重复写第二份 -->
    <dependency>
      <groupId>io.github.xiaou61</groupId>
      <artifactId>paideia-persistence</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <!-- 复用账号模块的测试装配（内存信箱），使注册链路的验证不依赖真实 SMTP -->
    <dependency>
      <groupId>io.github.xiaou61</groupId>
      <artifactId>paideia-account</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <!-- ApplicationModules.verify() 在 spring-modulith-core，只在测试期需要 -->
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>

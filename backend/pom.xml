<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>io.github.xiaou61</groupId>
  <artifactId>paideia</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Paideia</name>
  <description>Paideia 后端：千人千面 AI 个性化学习平台的架构底座</description>

  <modules>
    <module>paideia-platform</module>
    <module>paideia-web</module>
    <module>paideia-persistence</module>
    <module>paideia-security</module>
    <module>paideia-account</module>
    <module>paideia-knowledge</module>
    <module>paideia-note</module>
    <module>paideia-ai</module>
    <module>paideia-sandbox</module>
    <module>paideia-mcp</module>
    <module>paideia-ops</module>
    <module>paideia-app</module>
  </modules>

  <properties>
    <java.version>25</java.version>
    <spring-modulith.version>2.1.1</spring-modulith.version>
    <!--
      Flyway 刻意钉在高于 Boot BOM 的版本（BOM 当前给 12.4.0）。写在属性里而不是在子模块的
      dependency 上硬编码，是为了只留一处：BOM 的 dependencyManagement 正是按这个属性名解析的，
      在这里覆盖等于"有意识地抬版本"，而子模块里写 <version> 就成了绕过统一管理的散点。
    -->
    <flyway.version>13.10.0</flyway.version>
    <!--
      AWS SDK v2（对象存储用）。与 flyway 同一做法：版本写在属性里、由 BOM 统一解析，
      子模块只依赖 artifactId。它比 Boot BOM 里的任何东西都独立，所以必须自己管版本。
    -->
    <awssdk.version>2.31.0</awssdk.version>
    <!--
      PDFBox（WORK-018 简历识别用）。同样是"项目自带属性 + 子模块只写 artifactId"：
      它不在 Boot BOM 里，且 3.x 与 2.x 是**不兼容的大版本**（`PDDocument.load` 换成了
      `Loader.loadPDF`），把版本钉在一处比散在模块里更不容易踩错。
    -->
    <pdfbox.version>3.0.7</pdfbox.version>
    <!--
      MCP SDK（WORK-019）。**不是新依赖**：agentscope-core 已经把 0.17.2 传进来，这里显式 pin
      同一版本，防止依赖调解把它换掉——换掉之后 AgentScope 的 MCP 客户端会在运行期
      NoSuchMethodError。升级要等 AgentScope 一起升。
    -->
    <mcp-sdk.version>0.17.2</mcp-sdk.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- AWS SDK v2 的 BOM：s3 / auth / regions / http-client 各件的版本由它统一解析 -->
      <dependency>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>bom</artifactId>
        <version>${awssdk.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.modulith</groupId>
        <artifactId>spring-modulith-bom</artifactId>
        <version>${spring-modulith.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.github.xiaou61</groupId>
        <artifactId>paideia-platform</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.xiaou61</groupId>
        <artifactId>paideia-mcp</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.xiaou61</groupId>
        <artifactId>paideia-ops</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.xiaou61</groupId>
        <artifactId>paideia-sandbox</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.xiaou61</groupId>
        <artifactId>paideia-web</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.xiaou61</groupId>
        <artifactId>paideia-persistence</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.xiaou61</groupId>
        <artifactId>paideia-security</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.xiaou61</groupId>
        <artifactId>paideia-account</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.xiaou61</groupId>
        <artifactId>paideia-knowledge</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.xiaou61</groupId>
        <artifactId>paideia-note</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.xiaou61</groupId>
        <artifactId>paideia-ai</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>

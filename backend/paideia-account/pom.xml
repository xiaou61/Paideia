<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.xiaou61</groupId>
    <artifactId>paideia</artifactId>
    <version>0.0.1-SNAPSHOT</version>
  </parent>

  <artifactId>paideia-account</artifactId>
  <name>paideia-account</name>
  <description>账号与认证：账号实体、注册与登录、图形验证码与邮箱验证码</description>

  <!--
    依赖方向刻意单向：account -> security。
    security 是认证授权基础设施，它不认识账号表；账号是业务实体，将来其它业务模块
    要按 userId 关联数据时依赖本模块，而不是依赖 security。
  -->
  <dependencies>
    <dependency>
      <groupId>io.github.xiaou61</groupId>
      <artifactId>paideia-platform</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.xiaou61</groupId>
      <artifactId>paideia-persistence</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.xiaou61</groupId>
      <artifactId>paideia-security</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!--
      第三方登录要解析平台的 JSON 响应（WORK-037）。用 Boot 4 自带的 Jackson 3
      （tools.jackson.*），与 knowledge 模块同一口径：不引 Jackson 2，后者是 ai/mcp
      那条链的传递依赖，在本模块里没有直接版本管理。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jackson</artifactId>
    </dependency>
    <!-- 密码哈希用 Spring Security 的 BCrypt，不引第三方库 -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-crypto</artifactId>
    </dependency>
    <!-- 真实 SMTP 发信；未配置 paideia.mail.host 时不会用到它 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-mail</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Boot 4 把测试切片拆到独立模块：@AutoConfigureMockMvc 在这里 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- WORK-043 P3：登录成功率指标（SLO 用）。 -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-core</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- 测试支持（内存信箱与测试装配）打成 test-jar，供 paideia-app 的集成测试复用。
           这样"注册全链路"的验证不必依赖真实 SMTP，也不把测试专用实现放进生产产物。 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>test-jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>

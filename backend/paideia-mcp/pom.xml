<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.xiaou61</groupId>
    <artifactId>paideia</artifactId>
    <version>0.0.1-SNAPSHOT</version>
  </parent>

  <artifactId>paideia-mcp</artifactId>
  <name>paideia-mcp</name>
  <description>MCP 网关：把平台工具目录暴露给外部助手（WORK-019）</description>

  <!--
    依赖方向：mcp -> {platform, persistence, security}。

    **刻意不依赖任何业务模块**：工具实现由各模块注册成 `PaideiaTool` Bean，这里只认
    `paideia-platform` 的契约。依赖 business 模块会让"暴露哪些工具"变成编译期绑定，
    加一个工具就要改本模块的 pom——那正是目录要消灭的东西。

    **MCP SDK 不显式升级**：`agentscope-core` 已经把 `io.modelcontextprotocol.sdk:mcp` 传进来，
    这里显式 pin 同一版本，避免依赖调解把它换成别的版本（AgentScope 用的 API 会因此
    NoSuchMethodError）。见 WORK-019 的 research.md。
  -->
  <dependencies>
    <dependency>
      <groupId>io.github.xiaou61</groupId>
      <artifactId>paideia-platform</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.xiaou61</groupId>
      <artifactId>paideia-persistence</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.xiaou61</groupId>
      <artifactId>paideia-security</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- 指标（WORK-044 TASK-005）：MeterRegistry 来自 actuator 的 micrometer-core。
         只引 core 而不引 prometheus registry——registry 由 paideia-app 决定用哪一个。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- 与 AgentScope 传入的版本一致；不写版本号会随调解漂移 -->
    <dependency>
      <groupId>io.modelcontextprotocol.sdk</groupId>
      <artifactId>mcp</artifactId>
      <version>${mcp-sdk.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>

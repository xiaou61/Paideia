<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.xiaou61</groupId>
    <artifactId>paideia</artifactId>
    <version>0.0.1-SNAPSHOT</version>
  </parent>

  <artifactId>paideia-knowledge</artifactId>
  <name>paideia-knowledge</name>
  <description>知识库：层级分类、知识条目、条目关系、附件与学习者自评</description>

  <!--
    依赖方向：knowledge -> {platform, persistence, security}。

    **刻意不依赖 paideia-account**：本模块只需要"当前是谁"（取自令牌），不需要账号数据，
    因此 AccountApi 至今没有消费者，也不必为它引入一条模块依赖。
  -->
  <dependencies>
    <dependency>
      <groupId>io.github.xiaou61</groupId>
      <artifactId>paideia-platform</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.xiaou61</groupId>
      <artifactId>paideia-persistence</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.xiaou61</groupId>
      <artifactId>paideia-security</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!--
      学习记录把各块最高分存成 JSON 列（WORK-020）。用 Boot 4 自带的 Jackson 3
      （tools.jackson.*），不引 Jackson 2：后者是 ai/mcp 那条链的传递依赖，
      在本模块里没有直接版本管理。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jackson</artifactId>
    </dependency>
    <!-- WORK-072：分类树与条目摘要的 Redis 只读缓存。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>

    <!--
      对象存储（WORK-007）。**只本模块依赖**：附件读写是这一个模块的事，别的模块通过
      FileStorage 端口间接用到它，不该各自再引一遍 SDK。版本由根 pom 的 AWS BOM 统一给。
    -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Boot 4 把测试切片拆到独立模块 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
